# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Serwer
PORT=3000
NODE_ENV=development

# URL do serwera (potrzebne do Twilio webhook - użyj ngrok lokalnie)
BASE_URL=https://twoj-serwer.ngrok-free.app

# SMS po połączeniu (opcjonalne)
# true = wysyłaj SMS z linkiem Booksy do osoby dzwoniącej
SEND_CLIENT_BOOKSY_SMS=true
# true = wysyłaj powiadomienia wewnętrzne (Wiktoria / Damian / grupa salonu)
SEND_INTERNAL_NOTIFICATIONS=true
# Zachowane dla kompatybilności wstecznej
SEND_INTERNAL_SMS=true

# Kanał powiadomień wewnętrznych: whatsapp albo sms
INTERNAL_NOTIFICATIONS_CHANNEL=whatsapp

# Pilotaż: numery z tej listy dostają powiadomienia na WhatsAppie niezależnie od
# INTERNAL_NOTIFICATIONS_CHANNEL powyżej — reszta odbiorców zostaje na tamtym kanale.
# Wymaga ustawionego TWILIO_WHATSAPP_FROM (patrz niżej).
# WHATSAPP_PILOT_RECIPIENTS=+48698685251,+48xxxxxxxxx,+48xxxxxxxxx

# Numery odbiorców powiadomień (możesz też ustawić je w src/config/salon.js)
WIKTORIA_PHONE=+48000000000
DAMIAN_PHONE=+48000000000

# Opcjonalnie wymuś numer nadawcy SMS
# TWILIO_SMS_FROM=+48xxxxxxxxx

# Wymagane przy INTERNAL_NOTIFICATIONS_CHANNEL=whatsapp
# Przykład sandboxu Twilio: whatsapp:+14155238886
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

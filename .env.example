# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Serwer
PORT=3000
NODE_ENV=development

# URL do serwera (potrzebne do Twilio webhook - użyj ngrok lokalnie)
BASE_URL=https://twoj-serwer.ngrok-free.app

# SMS po połączeniu (opcjonalne)
# true = wysyłaj SMS z linkiem Booksy do osoby dzwoniącej
SEND_CLIENT_BOOKSY_SMS=true
# true = wysyłaj powiadomienia wewnętrzne (Wiktoria / Damian / grupa salonu)
SEND_INTERNAL_NOTIFICATIONS=true
# Zachowane dla kompatybilności wstecznej
SEND_INTERNAL_SMS=true

# Kanał powiadomień wewnętrznych (Wiktoria/Damian i barberzy z każdego salonu, patrz
# salonWhatsAppGroups w src/config/salon.js): whatsapp albo sms. WhatsApp jest tańszy niż SMS,
# więc to on jest domyślny — od 30.09.2026 idzie na wszystkich odbiorców jednym kanałem, bez
# wyjątków (dawny pilotaż/backup SMS odpadł razem z zatwierdzeniem szablonu poniżej).
INTERNAL_NOTIFICATIONS_CHANNEL=whatsapp

# SID zatwierdzonego przez Metę szablonu WhatsApp (Content API) — pozwala dostarczyć
# powiadomienie nawet komuś, kto nie pisał wcześniej do bota (freeform WhatsApp poza 24h
# oknem sesji kończy się błędem Twilio 63016). Bez tego WhatsApp działa tylko w oknie sesji.
# Ustawić dopiero PO zatwierdzeniu szablonu przez Metę (status "approved") — zatwierdzony
# 30.09.2026, więc na produkcji MUSI być ustawiony, inaczej WhatsApp do barberów (nigdy nie
# pisali do bota) będzie zawodził błędem 63016.
# TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numery odbiorców powiadomień (możesz też ustawić je w src/config/salon.js)
WIKTORIA_PHONE=+48000000000
DAMIAN_PHONE=+48000000000

# Opcjonalnie wymuś numer nadawcy SMS
# TWILIO_SMS_FROM=+48xxxxxxxxx

# Wymagane przy INTERNAL_NOTIFICATIONS_CHANNEL=whatsapp
# Przykład sandboxu Twilio: whatsapp:+14155238886
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
